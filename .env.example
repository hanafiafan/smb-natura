# Postgres connection string to your own database (self-hosted, VPS, etc.)
DATABASE_URL=postgres://user:password@host:5432/smb_natura

# Random 32+ char secret used to encrypt the login session cookie
SESSION_SECRET=change-me-to-a-random-32-char-or-longer-string

# Login accounts live in the `users` table (multi-tenant: super_admin sees every
# company/brand, brand_admin is scoped to whatever's assigned in user_brands).
# Bootstrap the first super_admin directly in the database:
#
#   node -e "const c=require('crypto');const s=c.randomBytes(16);const h=c.scryptSync(process.argv[1],s,64);console.log(s.toString('hex')+':'+h.toString('hex'))" "yourpassword"
#
#   insert into users (email, password_hash, role)
#   values ('owner@yourcompany.com', '<saltHex:hashHex from above>', 'super_admin');
